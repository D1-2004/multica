{{define "fields"}}<div class="case-fields"><section><h4>需要什么角色</h4><ul>{{range .Roles}}<li>{{.}}</li>{{end}}</ul></section><section><h4>测试验证的是什么</h4><ul>{{range .Verifies}}<li>{{.}}</li>{{end}}</ul></section><section><h4>怎么验证</h4><ol>{{range .Method}}<li>{{.}}</li>{{end}}</ol></section></div>{{end}}
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow"><title>黄金测试与场景 · FD Workbench</title><link rel="stylesheet" href="/api/evals/style.css"></head><body>
<a class="skip" href="#main">跳到评测集</a><header class="topbar"><a class="brand" href="/">FD Workbench</a><span>评测集</span></header>
<main id="main"><div class="page-heading"><div><h1>黄金测试与场景</h1><p>选择一项，在本页展开。</p></div><div class="counts"><span><strong>20</strong>黄金测试</span><span><strong>{{len .Scenarios}}</strong>场景</span><span><strong>{{.CaseCount}}</strong>分场景用例</span></div></div>
<div class="catalog-layout"><section class="golden-panel" id="golden"><div class="section-heading"><h2>P0 黄金测试集</h2><span>20 条组合回归</span></div><div class="item-list">{{range .Golden}}<details class="golden-item" id="{{.ID}}" {{if eq $.OpenGolden .ID}}open{{end}}><summary><span class="case-id">{{.ID}}</span><h3>{{.Title}}</h3></summary><div class="expanded-content">{{template "fields" .}}<p class="coverage">覆盖场景：{{range $i,$ref:=.ScenarioRefs}}{{if $i}}、{{end}}{{scenarioTitle $ref}}{{end}}</p></div></details>{{end}}</div></section>
<section class="scenario-panel" id="scenarios"><div class="section-heading"><h2>办公场景</h2><span>{{len .Scenarios}} 个场景</span></div><div class="item-list">{{range .Scenarios}}<details class="scenario-item" id="{{.ID}}" {{if eq $.OpenScenario .ID}}open{{end}}><summary><h3>{{.Title}}</h3><span class="case-count">{{len .Cases}} 条用例</span></summary><div class="expanded-content"><p class="scenario-description">{{.Description}}</p><div class="scenario-cases">{{range .Cases}}<details class="scenario-case" id="{{.ID}}"><summary><h4>{{.Title}}</h4></summary><div class="case-content">{{template "fields" .}}</div></details>{{end}}</div></div></details>{{end}}</div></section></div>
</main></body></html>
