{{define "fields"}}<div class="case-fields"><section><h4>需要什么角色</h4><ul>{{range .Roles}}<li>{{.}}</li>{{end}}</ul></section><section><h4>测试验证的是什么</h4><ul>{{range .Verifies}}<li>{{.}}</li>{{end}}</ul></section><section><h4>怎么验证</h4><ol>{{range .Method}}<li>{{.}}</li>{{end}}</ol></section></div>{{end}}
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow"><title>{{.ProductTitle}} 的 SPEC &amp; EVALS · FD Workbench</title><link rel="stylesheet" href="/api/evals/style.css"></head><body>
<a class="skip" href="#main">跳到内容</a><header class="topbar"><a class="brand" href="/">FD Workbench</a><span>{{.ProductTitle}}</span></header>
<main id="main"><div class="page-heading"><h1>{{.ProductTitle}} 的 <span>SPEC &amp; EVALS</span></h1><p>{{.Description}}</p></div>
<nav class="page-tabs" aria-label="内容导航"><a href="/evals?tab=spec" {{if eq .ActiveTab "spec"}}aria-current="page"{{end}}><strong>SPEC</strong><span>员工应做到什么</span></a><a href="/evals" {{if eq .ActiveTab "evals"}}aria-current="page"{{end}}><strong>EVALS</strong><span>如何验证</span></a></nav>
{{if eq .ActiveTab "spec"}}
<section class="spec-panel" aria-labelledby="spec-heading"><div class="section-heading"><h2 id="spec-heading">员工行为要求</h2><span>{{len .Requirements}} 类要求</span></div><div class="spec-list">{{range .Requirements}}<article class="spec-item" id="{{.ID}}"><div class="spec-topic"><h3>{{.Title}}</h3><p>{{.Summary}}</p></div><div class="spec-body"><ul>{{range .Requirements}}<li>{{.}}</li>{{end}}</ul><details class="related-evals"><summary>对应评测 · {{len .ScenarioRefs}} 个场景</summary><div class="scenario-links">{{range .ScenarioRefs}}<a href="/evals?scenario={{.}}#{{.}}">{{scenarioTitle .}} <span aria-hidden="true">↗</span></a>{{end}}</div></details></div></article>{{end}}</div></section>
{{else}}
<div class="catalog-layout"><section class="golden-panel" id="golden"><div class="section-heading"><h2>P0 GoldenCases</h2><span>{{len .Golden}} 条组合回归</span></div><div class="item-list">{{range .Golden}}<details class="golden-item" id="{{.ID}}" {{if eq $.OpenGolden .ID}}open{{end}}><summary><span class="case-id">{{.ID}}</span><h3>{{.Title}}</h3></summary><div class="expanded-content">{{template "fields" .}}<p class="coverage">覆盖场景：{{range $i,$ref:=.ScenarioRefs}}{{if $i}}、{{end}}{{scenarioTitle $ref}}{{end}}</p></div></details>{{end}}</div></section>
<section class="scenario-panel" id="scenarios"><div class="section-heading"><h2>通用办公场景用例</h2><span>{{len .Scenarios}} 场景 · {{.CaseCount}} 用例</span></div><div class="category-list">{{range .Categories}}<section class="scenario-category" id="category-{{.ID}}" aria-labelledby="category-title-{{.ID}}"><div class="category-heading"><h3 id="category-title-{{.ID}}">{{.Title}}</h3><span>{{len .Scenarios}} 场景 · {{.CaseCount}} 用例</span></div><div class="item-list">{{range .Scenarios}}<details class="scenario-item" id="{{.ID}}" {{if eq $.OpenScenario .ID}}open{{end}}><summary><h3>{{.Title}}</h3><span class="case-count">{{len .Cases}} 条用例</span></summary><div class="expanded-content"><p class="scenario-description">{{.Description}}</p><div class="scenario-cases">{{range .Cases}}<details class="scenario-case" id="{{.ID}}"><summary><h4>{{.Title}}</h4></summary><div class="case-content">{{template "fields" .}}</div></details>{{end}}</div></div></details>{{end}}</div></section>{{end}}</div></section></div>
{{end}}
</main></body></html>
