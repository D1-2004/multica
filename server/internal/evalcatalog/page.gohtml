{{define "case"}}<article class="test-case" id="{{.ID}}"><header><span class="case-id">{{.ID}}</span><h3>{{.Title}}</h3>{{if .Priority}}<span class="badge">{{.Priority}}</span>{{else if eq .Origin "defined"}}<span class="badge muted">新增定义</span>{{end}}</header><div class="case-fields"><section><h4>需要什么角色</h4><ul>{{range .Roles}}<li>{{.}}</li>{{end}}</ul></section><section><h4>测试验证的是什么</h4><ul>{{range .Verifies}}<li>{{.}}</li>{{end}}</ul></section><section><h4>怎么验证</h4><ol>{{range .Method}}<li>{{.}}</li>{{end}}</ol></section></div></article>{{end}}
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow"><title>评测中心 · FD Workbench</title><link rel="stylesheet" href="/api/evals/style.css"></head><body>
<a class="skip" href="#main">跳到正文</a><header class="topbar"><a class="brand" href="/">FD Workbench</a><span>评测中心 · 只读呈现</span></header>
<main id="main"><div class="page-heading"><div><p class="eyebrow">REPOSITORY EVALUATIONS</p><h1>评测中心</h1><p class="intro">群聊办公场景 · P0 组合回归 · 仓库评测资产</p></div><div class="counts"><a href="/evals?tab=evals#golden"><strong>20</strong>P0 Golden</a><a href="/evals?tab=evals#scenarios"><strong>{{.CaseCount}}</strong>分场景用例</a><a href="/evals?tab={{.Tab}}#assets"><strong>{{.DocumentCount}}</strong>Markdown 资产</a></div></div>
<nav class="tabs" aria-label="评测导航"><a href="/evals?tab=evals" {{if eq .Tab "evals"}}aria-current="page"{{end}}>评测集</a><a href="/evals?tab=tools" {{if eq .Tab "tools"}}aria-current="page"{{end}}>评测工具</a><a href="/evals?tab=runtime" {{if eq .Tab "runtime"}}aria-current="page"{{end}}>评测运行时</a></nav>
{{if .Document}}<article class="document-view"><a href="/evals?tab={{.Tab}}">← 返回{{if eq .Tab "evals"}}评测集{{else if eq .Tab "tools"}}评测工具{{else}}评测运行时{{end}}</a><header><h2>{{.Document.Title}}</h2>{{if .Document.Historical}}<span class="badge muted">历史资料</span>{{else}}<span class="badge">仓库资产</span>{{end}}</header><code class="source-path">{{.Document.Path}}</code><p class="document-hash">来源 SHA-256：{{.Document.SourceSHA256}}</p><div class="markdown">{{.Document.Body}}</div></article>
{{else if eq .Tab "evals"}}
{{if .Scenario}}<a class="back" href="/evals?tab=evals#scenarios">← 全部分场景测试</a><div class="section-heading"><h2>{{.Scenario.Title}}</h2><span>{{len .Scenario.Cases}} 条定义</span></div><p class="section-intro">{{.Scenario.Description}}</p>{{range .Scenario.Cases}}{{template "case" .}}{{end}}
{{else}}
<section id="scenarios"><div class="section-heading"><h2>分场景测试</h2><span>{{len .Scenarios}} 个办公场景</span></div><div class="scenario-grid">{{range .Scenarios}}<a class="scenario-card" href="/evals?tab=evals&scenario={{.ID}}"><div><h3>{{.Title}}</h3><p>{{.Description}}</p></div><span>{{len .Cases}} 条 ↗</span></a>{{end}}</div></section>
<section id="golden"><div class="section-heading"><h2>20 条 P0 Golden 组合回归</h2><span>从基础群聊到多场域协作与恢复</span></div><nav class="golden-index" aria-label="Golden 索引">{{range .Golden}}<a href="#{{.ID}}">{{.ID}} {{.Title}}</a>{{end}}</nav>{{range .Golden}}{{template "case" .}}<div class="coverage"><span>组合场景</span>{{range .ScenarioRefs}}<a href="/evals?tab=evals&scenario={{.}}">{{scenarioTitle .}}</a>{{end}}<span>分场景引用：{{len .CaseRefs}} 条</span></div>{{end}}</section>
{{end}}
{{else}}<section class="guide markdown">{{.Guide}}</section>{{end}}
{{if not .Document}}<section class="assets" id="assets"><div class="section-heading"><h2>仓库 Markdown 资产</h2><span>文件快照与源码 hash 同步</span></div><div class="asset-list">{{range .Documents}}{{if eq .Category $.Tab}}<a href="{{docURL .Path $.Tab}}"><div><h3>{{.Title}}</h3><code>{{.Path}}</code></div><span class="badge {{if .Historical}}muted{{end}}">{{if .Historical}}历史资料{{else}}{{.Kind}}{{end}}</span></a>{{end}}{{end}}</div></section>{{end}}
<footer>用例定义与运行结果分别记录。仓库资产同步入口：<code>scripts/sync-eval-assets.py</code></footer></main></body></html>
