{{define "fields"}}<div class="case-fields"><section><h4>需要什么角色</h4><ul>{{range .Roles}}<li>{{.}}</li>{{end}}</ul></section><section><h4>测试验证的是什么</h4><ul>{{range .Verifies}}<li>{{.}}</li>{{end}}</ul></section><section><h4>怎么验证</h4><ol>{{range .Method}}<li>{{.}}</li>{{end}}</ol></section></div>{{end}}
{{define "ready"}}{{if .LiveReady}}<span class="ready-mark">可跑可验证</span>{{end}}{{end}}
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow"><title>{{.ProductTitle}} SPEC &amp; EVALS</title><link rel="stylesheet" href="/api/evals/style.css"></head><body>
<a class="skip" href="#main">跳到内容</a>
<main id="main"><div class="page-heading"><h1>{{.ProductTitle}} <span>SPEC &amp; EVALS</span></h1><p>{{.Description}}</p></div>
<nav class="page-tabs" aria-label="内容导航"><a href="/evals?tab=spec" {{if eq .ActiveTab "spec"}}aria-current="page"{{end}}><strong>SPEC</strong><span>员工应做到什么</span></a><a href="/evals" {{if eq .ActiveTab "evals"}}aria-current="page"{{end}}><strong>EVALS</strong><span>如何验证</span></a><a href="/evals?tab=reports" {{if eq .ActiveTab "reports"}}aria-current="page"{{end}}><strong>评测报告</strong><span>本地上报结果</span></a></nav>
{{if eq .ActiveTab "spec"}}
<section class="spec-panel" aria-labelledby="spec-heading"><div class="section-heading"><h2 id="spec-heading">员工行为要求</h2><span>{{len .Requirements}} 类要求</span></div><div class="spec-list">{{range .Requirements}}<article class="spec-item" id="{{.ID}}"><div class="spec-topic"><h3>{{.Title}}</h3><p>{{.Summary}}</p></div><div class="spec-body"><ul>{{range .Requirements}}<li>{{.}}</li>{{end}}</ul><details class="related-evals"><summary>对应评测 · {{len .ScenarioRefs}} 个场景</summary><div class="scenario-links">{{range .ScenarioRefs}}<a href="/evals?scenario={{.}}#{{.}}">{{scenarioTitle .}} <span aria-hidden="true">↗</span></a>{{end}}</div></details></div></article>{{end}}</div></section>
{{else if eq .ActiveTab "evals"}}
<p class="ready-note">标出的条目可以在当前预发用真实对话跑完，对错能在对话或收到的文件里核对。未标出的条目还缺运行条件，或核对点不在对话里。</p>
<div class="catalog-layout"><section class="golden-panel" id="golden"><div class="section-heading"><h2>P0 GoldenCases</h2><span>{{len .Golden}} 条组合回归 · {{.ReadyGolden}} 条可跑可验证</span></div><div class="item-list">{{range .Golden}}<details class="golden-item" id="{{.ID}}" {{if eq $.OpenGolden .ID}}open{{end}}><summary><span class="case-id">{{.ID}}</span><h3>{{.Title}}</h3>{{template "ready" .}}</summary><div class="expanded-content">{{template "fields" .}}<p class="coverage">覆盖场景：{{range $i,$ref:=.ScenarioRefs}}{{if $i}}、{{end}}{{scenarioTitle $ref}}{{end}}</p></div></details>{{end}}</div></section>
<section class="scenario-panel" id="scenarios"><div class="section-heading"><h2>通用办公场景用例</h2><span>{{len .Scenarios}} 场景 · {{.CaseCount}} 用例 · {{.ReadyCases}} 条可跑可验证</span></div><div class="category-list">{{range .Categories}}<section class="scenario-category" id="category-{{.ID}}" aria-labelledby="category-title-{{.ID}}"><div class="category-heading"><h3 id="category-title-{{.ID}}">{{.Title}}</h3><span>{{len .Scenarios}} 场景 · {{.CaseCount}} 用例 · {{.CaseReady}} 条可跑可验证</span></div><div class="item-list">{{range .Scenarios}}<details class="scenario-item" id="{{.ID}}" {{if eq $.OpenScenario .ID}}open{{end}}><summary><h3>{{.Title}}</h3><span class="case-count">{{len .Cases}} 条用例</span></summary><div class="expanded-content"><p class="scenario-description">{{.Description}}</p><div class="scenario-cases">{{range .Cases}}<details class="scenario-case" id="{{.ID}}"><summary><h4>{{.Title}}</h4>{{template "ready" .}}</summary><div class="case-content">{{template "fields" .}}</div></details>{{end}}</div></div></details>{{end}}</div></section>{{end}}</div></section></div>
{{else}}
<section class="reports-panel" aria-labelledby="reports-heading"><div class="section-heading"><h2 id="reports-heading">评测报告</h2><a class="contract-link" href="/api/evals/report-contract">上报接口合同 ↗</a></div><p class="report-intro">本地上报结果，按当次用例定义保存。真实 E2E、模拟测试和定义检查分别记录。</p>
{{if .ReportError}}<div class="report-empty" role="status"><h3>报告暂不可用</h3><p>报告服务连接恢复后，可查看已上报记录。</p></div>
{{else if .Detail}}{{with .Detail}}<a class="back-link" href="/evals?tab=reports">← 全部报告</a><article class="report-detail"><div class="report-title"><h3>{{.Submission.Title}}</h3><span class="status status-{{.Summary.Conclusion}}">{{statusLabel .Summary.Conclusion}}</span></div><div class="report-context"><span>{{.WorkspaceName}}</span><span>{{.Submission.Environment}}</span><span>{{executionLabel .Submission.ExecutionKind}}</span><span>{{.Submission.FinishedAt.Format "2006-01-02 15:04 UTC"}}</span></div><div class="report-stats"><span><strong>{{.Summary.Pass}} / {{.Summary.Total}}</strong>选例通过</span><span><strong>{{.Summary.Fail}}</strong>失败</span><span><strong>{{.Summary.Blocked}}</strong>阻塞</span><span><strong>{{.Summary.Incomplete}}</strong>未完成</span><span><strong>{{.Summary.Skipped}}</strong>未执行</span><span><strong>{{.Summary.P0Selected}} / {{.Summary.P0Total}}</strong>P0 选例覆盖</span></div><details class="report-provenance"><summary>运行与定义版本</summary><dl><dt>执行器</dt><dd>{{.Submission.Runner.Name}} · {{.Submission.Runner.Version}}</dd><dt>被测版本</dt><dd><code>{{.Submission.TargetRevision}}</code></dd><dt>定义版本</dt><dd><code>{{.Submission.Catalog.Revision}}</code>{{if .Submission.Catalog.Dirty}} · 含本地修改{{end}}</dd><dt>定义快照</dt><dd><code>{{.DefinitionSHA256}}</code></dd><dt>运行 ID</dt><dd><code>{{.Submission.RunID}}</code></dd><dt>上报时间</dt><dd>{{.ReceivedAt.Format "2006-01-02 15:04 UTC"}}</dd></dl></details></article>{{end}}
<div class="report-case-list">{{range .ReportCases}}<details class="report-case"><summary><span class="status status-{{.Result.Status}}">{{caseStatusLabel .Result.Status}}</span><h3>{{.Definition.Title}}</h3></summary><div class="case-content"><p class="result-summary">{{.Result.Summary}}</p><details class="frozen-definition"><summary>当次用例定义</summary>{{template "fields" .Definition}}</details>{{if .Result.Evidence}}<section class="report-evidence"><h4>证据引用</h4><ul>{{range .Result.Evidence}}<li><span>{{.Kind}}</span>{{if httpsReference .Reference}}<a href="{{.Reference}}" rel="noreferrer noopener">{{.Reference}}</a>{{else}}<code>{{.Reference}}</code>{{end}}</li>{{end}}</ul></section>{{end}}</div></details>{{end}}</div>
{{else if .Reports}}<div class="report-list">{{range .Reports}}<a class="report-row" href="/evals?tab=reports&amp;workspace_id={{.WorkspaceID}}&amp;report={{.ID}}"><div><h3>{{.Submission.Title}}</h3><p>{{.WorkspaceName}} · {{.Submission.Environment}} · {{executionLabel .Submission.ExecutionKind}}</p></div><div class="report-row-result"><span class="status status-{{.Summary.Conclusion}}">{{statusLabel .Summary.Conclusion}}</span><span>{{.Summary.Pass}} / {{.Summary.Total}} 通过 · {{.Summary.Fail}} 失败</span><time>{{.Submission.FinishedAt.Format "2006-01-02 15:04 UTC"}}</time></div></a>{{end}}</div><p class="report-note">显示最近 {{len .Reports}} 份可访问报告。</p>
{{else}}<div class="report-empty"><h3>暂无上报报告</h3><p>本地评测完成后，通过上报接口提交结果。</p></div>{{end}}
</section>
{{end}}
</main></body></html>
