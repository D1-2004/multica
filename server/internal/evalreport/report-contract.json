{
  "openapi": "3.1.0",
  "info": {
    "title": "QwenTag local evaluation report contract",
    "version": "1",
    "description": "Immutable locally reported results. Acceptance is persistence only, not server execution or evidence review. SPEC and EVALS remain unchanged."
  },
  "security": [
    {
      "humanSession": []
    },
    {
      "humanPAT": []
    }
  ],
  "paths": {
    "/api/workspaces/{workspace_id}/eval-reports": {
      "parameters": [
        {
          "name": "workspace_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          }
        }
      ],
      "post": {
        "operationId": "submitEvalReport",
        "description": "Requires current human membership. Authenticated user supplies submitted_by. Same workspace/run ID and normalized content replay unchanged; different content conflicts. No client totals. At most 2 MiB. Secrets and signed evidence URLs are forbidden. Selected cases and results are sorted by ID and RFC3339 timestamps normalized to UTC before SHA-256 hashing. Each selected case has exactly one result. Definitions may be local and unpublished. Definitions and received results are frozen. Pass/fail requires at least one credential-free HTTPS or redacted relative reference; the server does not fetch references.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submission"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved once",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "200": {
            "description": "Same immutable report replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, evidence reference or case mapping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Non-human identity or insufficient access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Workspace or report is not visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Run ID already has different content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 2 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Content-Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Report storage is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listEvalReports",
        "description": "Rechecks current workspace membership. Descending received_at and id; before_id is the last record ID on the previous page. Missing or invisible cursor returns 404. Lists only report metadata and summaries; selected definitions and result arrays are fetched from the scoped detail endpoint.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "before_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Visible reports",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, evidence reference or case mapping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Non-human identity or insufficient access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Workspace or report is not visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Report storage is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{workspace_id}/eval-reports/{report_id}": {
      "parameters": [
        {
          "name": "workspace_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          }
        },
        {
          "name": "report_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          }
        }
      ],
      "get": {
        "operationId": "getEvalReport",
        "description": "Rechecks current workspace membership; the report does not grant access.",
        "responses": {
          "200": {
            "description": "Frozen definitions and results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, evidence reference or case mapping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Non-human identity or insufficient access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Workspace or report is not visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Report storage is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/evals/report-contract": {
      "get": {
        "operationId": "getEvalReportContract",
        "responses": {
          "200": {
            "description": "This OpenAPI 3.1 contract",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Non-human identity or insufficient access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "humanSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "multica_auth",
        "description": "Existing authenticated human session; service/task/node credentials are rejected before membership resolution."
      },
      "humanPAT": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing human PAT; service/task/node credentials are rejected before membership resolution."
      }
    },
    "schemas": {
      "Runner": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          }
        }
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "dirty",
          "sha256"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})$"
          },
          "dirty": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          }
        }
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference"
        ],
        "properties": {
          "kind": {
            "enum": [
              "im",
              "api",
              "trace",
              "log",
              "artifact"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      },
      "CaseDefinition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "scenario_id",
          "roles",
          "verifies",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^(G(0[1-9]|1[0-9]|20)|[a-z][a-z0-9]*(-[a-z0-9]+)*)$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "p0",
              "office"
            ]
          },
          "scenario_id": {
            "type": "string",
            "maxLength": 160
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "\\S"
            }
          },
          "verifies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          },
          "method": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "p0"
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "pattern": "^G(0[1-9]|1[0-9]|20)$"
                },
                "scenario_id": {
                  "const": ""
                }
              }
            },
            "else": {
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 160,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                },
                "scenario_id": {
                  "type": "string",
                  "maxLength": 160,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                }
              }
            }
          }
        ]
      },
      "CaseResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "status",
          "summary",
          "evidence"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^(G(0[1-9]|1[0-9]|20)|[a-z][a-z0-9]*(-[a-z0-9]+)*)$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "incomplete",
              "skipped"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "array",
            "minItems": 0,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "run_id",
          "title",
          "execution_kind",
          "environment",
          "target_revision",
          "runner",
          "started_at",
          "finished_at",
          "catalog",
          "selected_cases",
          "results"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "execution_kind": {
            "enum": [
              "real_e2e",
              "mock",
              "definition_check"
            ]
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "target_revision": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{40}|[0-9A-Fa-f]{64}|sha256:[0-9A-Fa-f]{64})$"
          },
          "runner": {
            "$ref": "#/components/schemas/Runner"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "catalog": {
            "$ref": "#/components/schemas/Catalog"
          },
          "selected_cases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/CaseDefinition"
            }
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/CaseResult"
            }
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "pass",
          "fail",
          "blocked",
          "incomplete",
          "skipped",
          "p0_selected",
          "real_e2e_pass",
          "pass_rate",
          "conclusion",
          "p0_total"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "pass": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "fail": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "blocked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "incomplete": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "skipped": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "p0_selected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "real_e2e_pass": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "pass_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "conclusion": {
            "enum": [
              "pass",
              "fail",
              "incomplete"
            ]
          },
          "p0_total": {
            "const": 20
          }
        }
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspace_id",
          "workspace_name",
          "submitted_by",
          "received_at",
          "content_sha256",
          "definition_sha256",
          "submission",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          },
          "workspace_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "submitted_by": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "definition_sha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "submission": {
            "$ref": "#/components/schemas/Submission"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          }
        }
      },
      "ReportList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reports",
          "has_more"
        ],
        "properties": {
          "reports": {
            "type": "array",
            "minItems": 0,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/ReportMetadata"
            }
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspace_id",
          "submitted_by",
          "received_at",
          "content_sha256",
          "definition_sha256",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          },
          "submitted_by": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "definition_sha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          }
        }
      },
      "ReportMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspace_id",
          "submitted_by",
          "received_at",
          "content_sha256",
          "definition_sha256",
          "summary",
          "workspace_name",
          "run_id",
          "title",
          "execution_kind",
          "environment",
          "target_revision",
          "runner",
          "started_at",
          "finished_at",
          "catalog"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          },
          "submitted_by": {
            "type": "string",
            "format": "uuid",
